    1ce2:	de b7       	in	r29, 0x3e	; 62
	//TCC0 is used as tick timer
	TCC0.CCA=65535;
    1ce4:	80 e0       	ldi	r24, 0x00	; 0
    1ce6:	98 e0       	ldi	r25, 0x08	; 8
    1ce8:	2f ef       	ldi	r18, 0xFF	; 255
    1cea:	3f ef       	ldi	r19, 0xFF	; 255
