    1cfe:	98 e0       	ldi	r25, 0x08	; 8
    1d00:	20 e4       	ldi	r18, 0x40	; 64
    1d02:	fc 01       	movw	r30, r24
    1d04:	21 83       	std	Z+1, r18	; 0x01
	TCC0.INTCTRLA=0b00000001; //OVF priority LOW
