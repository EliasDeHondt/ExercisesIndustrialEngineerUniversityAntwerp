	TCC0.CTRLA=0b00000001; //DIV1
    1cf2:	80 e0       	ldi	r24, 0x00	; 0
    1cf4:	98 e0       	ldi	r25, 0x08	; 8
    1cf6:	21 e0       	ldi	r18, 0x01	; 1
    1cf8:	fc 01       	movw	r30, r24
    1cfa:	20 83       	st	Z, r18
	TCC0.CTRLB=1<<6;
